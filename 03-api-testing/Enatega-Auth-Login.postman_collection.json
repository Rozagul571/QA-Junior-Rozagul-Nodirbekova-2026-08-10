{
  "info": {
    "_postman_id": "b7e1c2a4-9f3d-4a21-8e6c-qa2026081001",
    "name": "Enatega — Auth / Login API Tests",
    "description": "QA Automation assignment — Part 3 (API Testing).\n\nFolder 1 tests the assignment-specified contract `POST /api/v1/auth/login` (phone_number + otp_code) with 1 positive and 3 negative cases, each with assertions on status code, response body and error messages. `base_url` is an environment variable so the same collection runs against any conforming server or a Postman mock.\n\nFolder 2 is a BONUS: real, live API tests against the actual Enatega backend (GraphQL), which is what the app under test really uses. These requests genuinely execute and assert on real responses.\n\nAuthor: Rozagul Nodirbekova — 2026-08-10",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Spec contract — POST /api/v1/auth/login",
      "item": [
        {
          "name": "Positive — valid phone + valid OTP → 200 + token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Guard: fail clearly if the server is unreachable",
                  "pm.test('Server responded', function () {",
                  "    pm.expect(pm.response.code, 'no response — is base_url set to a running server?').to.not.be.undefined;",
                  "});",
                  "",
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is JSON', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
                  "});",
                  "",
                  "pm.test('Response contains a non-empty token', function () {",
                  "    var json = pm.response.json();",
                  "    var token = json.token || (json.data && json.data.token);",
                  "    pm.expect(token, 'token missing in response').to.be.a('string').and.to.have.length.above(10);",
                  "    if (token) pm.environment.set('auth_token', token);",
                  "});",
                  "",
                  "pm.test('Response time is under 2000ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"+998901234567\",\n  \"otp_code\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Happy path: valid phone number and valid OTP should return 200 and an auth token."
          }
        },
        {
          "name": "Negative — invalid OTP → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('No token is returned', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.token, 'token must not be issued for a wrong OTP').to.be.undefined;",
                  "});",
                  "",
                  "pm.test('Error message mentions the OTP', function () {",
                  "    var json = pm.response.json();",
                  "    var msg = (json.error || json.message || '').toString().toLowerCase();",
                  "    pm.expect(msg).to.match(/otp|code|invalid|incorrect/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"+998901234567\",\n  \"otp_code\": \"000000\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Wrong OTP for a valid phone number must be rejected with 401 and a helpful error."
          }
        },
        {
          "name": "Negative — missing phone_number → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Error identifies the missing field', function () {",
                  "    var json = pm.response.json();",
                  "    var msg = (json.error || json.message || JSON.stringify(json)).toLowerCase();",
                  "    pm.expect(msg).to.include('phone');",
                  "});",
                  "",
                  "pm.test('No token is returned', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.token).to.be.undefined;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp_code\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Omitting the required phone_number must return 400 with a validation error naming the field."
          }
        },
        {
          "name": "Negative — invalid phone format → 400/422",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400 or 422', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 422]);",
                  "});",
                  "",
                  "pm.test('Error mentions format / validation', function () {",
                  "    var json = pm.response.json();",
                  "    var msg = (json.error || json.message || JSON.stringify(json)).toLowerCase();",
                  "    pm.expect(msg).to.match(/format|invalid|valid|phone/);",
                  "});",
                  "",
                  "pm.test('No token is returned', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.token).to.be.undefined;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"12345\",\n  \"otp_code\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "A malformed phone number (no country code / too short) must fail validation."
          }
        }
      ],
      "description": "Assignment-specified REST contract. Set {{base_url}} to a server that implements it (or a Postman mock). NOTE: the real Enatega backend does not expose this REST route (returns 404) — it uses GraphQL, tested in folder 2."
    },
    {
      "name": "2. BONUS — Live Enatega GraphQL API",
      "item": [
        {
          "name": "Spec route on real backend → documents 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Real backend has no REST /api/v1/auth/login (404)', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "// Finding: the app under test authenticates via GraphQL, not this REST route."
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"+998901234567\",\n  \"otp_code\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{graphql_host}}/api/v1/auth/login",
              "host": ["{{graphql_host}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "GraphQL login — invalid types are rejected (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Server responded 400 for invalid variable type', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('GraphQL validation error present', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.errors, 'expected GraphQL errors array').to.be.an('array');",
                  "    pm.expect(json.errors[0].extensions.code).to.eql('GRAPHQL_VALIDATION_FAILED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation Login($email:String,$password:String,$type:String,$notificationToken:String){ login(email:$email,password:$password,type:$type,notificationToken:$notificationToken){ userId token } }\",\n  \"variables\": { \"email\": \"demo-customer@enatega.com\", \"password\": \"123123\", \"type\": \"default\", \"notificationToken\": null }\n}"
            },
            "url": {
              "raw": "{{graphql_host}}/graphql",
              "host": ["{{graphql_host}}"],
              "path": ["graphql"]
            },
            "description": "Live negative test: `$type` declared nullable but the schema needs `String!` → server returns a structured GRAPHQL_VALIDATION_FAILED error. Demonstrates real API-contract testing."
          }
        },
        {
          "name": "GraphQL login — wrong password is unauthorized",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 (GraphQL transport)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('No data / login is not granted', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data == null || json.data.login == null).to.be.true;",
                  "    pm.expect(json.errors, 'expected an errors array').to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation Login($email:String!,$password:String!,$type:String!){ login(email:$email,password:$password,type:$type){ token } }\",\n  \"variables\": { \"email\": \"demo-customer@enatega.com\", \"password\": \"wrong-password\", \"type\": \"default\" }\n}"
            },
            "url": {
              "raw": "{{graphql_host}}/graphql",
              "host": ["{{graphql_host}}"],
              "path": ["graphql"]
            },
            "description": "Live negative test with an incorrect password — the mutation must not return a token."
          }
        }
      ],
      "description": "These requests run against the real backend the customer app uses: https://aws-server-v2.enatega.com"
    }
  ],
  "variable": [
    { "key": "base_url", "value": "https://api.your-fooddelivery-server.com", "type": "string" },
    { "key": "graphql_host", "value": "https://aws-server-v2.enatega.com", "type": "string" }
  ]
}
